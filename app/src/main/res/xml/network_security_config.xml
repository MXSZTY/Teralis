<?xml version="1.0" encoding="utf-8"?>
<!-- Teralis 是通用 WebView 浏览器，用户可能访问内网 http 地址，因此放行明文流量。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
